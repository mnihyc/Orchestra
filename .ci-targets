# Check the frame merge's unmerged second parent. Its final lane run selected only redaction unit tests.
test -p orch-engine --test turns -- a_second_queued_input_runs_with_default_worker_stacks_even_if_the_suite_stack_is_larger
test -p orch-engine --lib -- source_generation_retention_runs_with_default_worker_stacks_even_if_the_suite_stack_is_larger
test -p orch-engine --lib -- a_malformed_frozen_parent_rolls_back_every_copied_row
