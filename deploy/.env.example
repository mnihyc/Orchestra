# The environment of the stack. Run `install -m 600 .env.example .env` in this
# directory, where Compose reads it, and fill in what is marked. update.sh refuses to start
# anything while the password is missing or weak, and never changes your values.

# --- You decide these ---------------------------------------------------------

# The database password. At least 24 characters, only letters, digits, "-" and
# "_" (it is written into a URL), and not a placeholder. Make one with:
#   openssl rand -base64 24 | tr '+/' '-_'
POSTGRES_PASSWORD=

# Where the web application is published, for the HTTPS edge you run in front of
# it. The default listens on this host only.
#ORCH_FRONTEND_BIND=127.0.0.1:5180

# Optional HTTPS from the same web edge, using Orch's existing authority.
# Trust config/secrets/orch_ca_cert.pem on devices that open it.
#ORCH_FRONTEND_HTTPS_BIND=0.0.0.0:443

# Where the gateway's pinned listener is published: [address:]port:9443. It is
# what connected machines and managed runtimes connect to, so it must be
# reachable from them and from nothing else. Without an address it is published
# on every address of this host. Give the address of the Docker bridge
# (usually 172.17.0.1) to keep it to this host's own containers, and a port
# that the advertised endpoints in config/orch.toml name. If the host port
# differs from 9443, change [gateway] managed_endpoint to that port too;
# [node] gateway_url still uses the container's 9443.
#ORCH_GATEWAY_PUBLISH=9443:9443

# Optional address for the updater's host-side edge readiness check when this
# host reaches the same deployment by a different route than public_url.
#ORCH_READY_URL=https://orch.example.com

# Where update.sh fetches a release when it is not given a directory (--from).
# <base>/download/vX.Y.Z/ and <base>/latest/download/ hold version.json and the
# files it lists.
#ORCH_RELEASE_URL=https://github.com/OWNER/Orchestra/releases

# The host's Docker socket if it is not /var/run/docker.sock. The node sees it
# inside the container at /var/run/docker.sock. If the socket or its group
# changes after first start, update ORCH_DOCKER_GID below and recreate the node.
#DOCKER_SOCKET=/path/to/docker.sock

# The name of the Compose project, and so of its containers and networks.
#COMPOSE_PROJECT_NAME=orch

# --- Written by `update.sh first-start`; the facts of this machine ------------
# Leave them alone, or set them yourself before the first start to choose.
#
# ORCH_HOME: this directory, as the Docker host knows it.
# ORCH_UID, ORCH_GID: the user and group every service runs as.
# ORCH_DOCKER_GID: the group that owns the Docker socket, for the node.

# Keep this after the optional HTTPS bind: Compose expands .env values in order.
COMPOSE_FILE=compose.yml${ORCH_FRONTEND_HTTPS_BIND:+:compose.frontend-https.yml}
