{
  "contract": 1,
  "interfaces": {
    "openai-images": {
      "title": "Compatible Images API",
      "kind": "images",
      "implementation": "image-api",
      "shape": {
        "input_schema": {
          "type": "object",
          "required": [
            "model",
            "prompt"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "quality": {
              "type": "string",
              "minLength": 1
            },
            "background": {
              "type": "string",
              "minLength": 1
            },
            "output_format": {
              "type": "string",
              "minLength": 1
            },
            "output_compression": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "stream": {
              "const": false
            }
          }
        },
        "request": {
          "method": "POST",
          "path": "/images/generations",
          "encoding": "json",
          "body": {
            "from_input": ""
          }
        },
        "result": {
          "schema": {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "error": {
                "type": "null"
              },
              "data": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "b64_json"
                  ],
                  "properties": {
                    "b64_json": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "page": {
            "from_response": "/data"
          },
          "usage": {
            "from_response": "/usage",
            "optional": true
          },
          "format": {
            "from_response": "/output_format",
            "optional": true
          },
          "media_types": {
            "png": "image/png",
            "jpeg": "image/jpeg",
            "webp": "image/webp",
            "gif": "image/gif",
            "svg": "image/svg+xml"
          }
        },
        "counters": {
          "input_tokens": {
            "pointer": "/usage/input_tokens",
            "unit": "token"
          },
          "output_tokens": {
            "pointer": "/usage/output_tokens",
            "unit": "token"
          },
          "image_generation": {
            "unit": "image",
            "items": {
              "pointer": "/data",
              "base64": "/b64_json"
            }
          }
        },
        "x_actions": {
          "edits": {
            "input_schema": {
              "type": "object",
              "required": [
                "model",
                "prompt",
                "image"
              ]
            },
            "request": {
              "method": "POST",
              "path": "/images/edits",
              "encoding": "multipart",
              "body": {
                "from_input": ""
              },
              "array_fields": {
                "image": "image[]"
              }
            },
            "result": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "error": {
                    "type": "null"
                  },
                  "data": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "b64_json"
                      ],
                      "properties": {
                        "b64_json": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              "page": {
                "from_response": "/data"
              },
              "usage": {
                "from_response": "/usage",
                "optional": true
              },
              "format": {
                "from_response": "/output_format",
                "optional": true
              },
              "media_types": {
                "png": "image/png",
                "jpeg": "image/jpeg",
                "webp": "image/webp",
                "gif": "image/gif",
                "svg": "image/svg+xml"
              }
            }
          }
        }
      }
    }
  }
}
