                  "type": "object",
                  "required": [
                    "type",
                    "status",
                    "id",
                    "result"
                  ],
                  "properties": {
                    "type": {
                      "const": "image_generation_call"
                    },
                    "status": {
                      "const": "completed"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "item": {
                  "b64_json": {
                    "from_result": "/result"
                  },
                  "native_ref": {
                    "from_result": "/id"
                  },
                  "media_type": {
                    "from_result": "/media_type",
                    "optional": true
                  },
                  "revised_prompt": {
                    "from_result": "/revised_prompt",
                    "optional": true
                  }
                }
              }
            ],
            "usage": {
              "from_response": "/usage",
              "optional": true
            }
          },
          "counters": {
            "input_tokens": {
              "pointer": "/usage/input_tokens",
              "unit": "token"
            },
            "output_tokens": {
              "pointer": "/usage/output_tokens",
              "unit": "token"
            },
            "image_input_tokens": {
              "pointer": "/tool_usage/image_gen/input_tokens",
              "unit": "token"
            },
            "image_output_tokens": {
              "pointer": "/tool_usage/image_gen/output_tokens",
              "unit": "token"
