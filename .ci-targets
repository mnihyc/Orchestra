test -p orch-api-core --test provider_crud_scopes --test provider_list_scopes --test provider_name_operation_scopes --test provider_admin_sources --test providers
# Last, since one of its cases did not end in earlier batches: the engine's unit-test program whole.
test -p orch-engine --lib
