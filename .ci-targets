# b42g-b: the same assembly: the engine's and the API's programs of every merged lane (the engine's unit run without the two history-pages cases, which are another lane's item)
test -p orch-engine --lib -- --skip history_pages::
test -p orch-engine --test preflight --test summary_targets --test model_parameters --test call_recovery --test provider_rejection --test search_projections --test source_uniform --test environments
test -p orch-settings --test matrix_inheritance
test -p orch-api-base --lib
test -p orch-api-core --lib
test -p orch-api-core --test container_units --test everything_resources --test realtime_diagnostics --test kfix_binding --test settings --test threads_settings --test model_entries --test provider_models --test ask --test binding_options --test binding_readiness --test component_updates --test machine_policy_scopes --test machine_registration --test search_names --test search_native_scopes --test documents --test document_list_scopes --test private_documents --test search_content --test threads_start_source
