{
  "contract": 1,
  "interfaces": {
    "openrouter-images": {
      "title": "OpenRouter Image API",
      "kind": "images",
      "implementation": "image-api",
      "shape": {
        "input_schema": {
          "type": "object",
          "required": [
            "model",
            "prompt"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "input_references": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "resolution": {
              "type": "string",
              "minLength": 1
            },
            "aspect_ratio": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "quality": {
              "type": "string",
              "minLength": 1
            },
            "output_format": {
              "type": "string",
              "minLength": 1
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "background": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer"
            },
            "provider": {
              "type": "object"
            },
            "stream": {
              "const": false
            }
          }
        },
        "request": {
          "method": "POST",
          "path": "/images",
          "encoding": "json",
          "body": {
            "from_input": ""
          }
        },
        "result": {
          "schema": {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "error": {
                "type": "null"
              },
              "data": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "b64_json"
                  ],
                  "properties": {
                    "b64_json": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "page": {
            "from_response": "/data"
          },
          "usage": {
            "from_response": "/usage",
            "optional": true
          }
        },
        "counters": {
          "input_tokens": {
            "pointer": "/usage/prompt_tokens",
            "unit": "token"
          },
          "output_tokens": {
            "pointer": "/usage/completion_tokens",
            "unit": "token"
          },
          "reported_cost": {
            "pointer": "/usage/cost",
            "unit": "USD",
            "reported_cost": true
          }
        },
        "discovery": {
          "request": {
            "method": "GET",
            "path": "/images/models"
          },
          "collection": "/data",
          "id": "/id",
          "enabled": false,
          "endpoint_request": {
            "method": "GET",
            "path_template": "/images/models/{id}/endpoints"
          },
          "endpoint_collection": "/endpoints",
          "definitive_options": "/supported_parameters",
          "passthrough": "/allowed_passthrough_parameters",
          "pricing": "/pricing",
          "streaming": "/supports_streaming",
          "provider_tag": "/provider_tag"
        },
        "x_stream": {
          "partial": {
            "type": "image_generation.partial_image",
            "bytes": "/b64_json",
            "index": "/partial_image_index",
            "completed": false
          },
          "completed": {
            "type": "image_generation.completed",
            "bytes": "/b64_json",
            "media_type": "/media_type",
            "usage": "/usage",
            "completed": true
          },
          "error": {
            "type": "error",
            "completed": false
          },
          "done": "[DONE]"
        },
        "x_billing": {
          "completed_only": true,
          "reported_total_precedes_estimates": true,
          "interrupted_without_completed": "unbilled"
        },
        "x_input_images": {
          "encoding": "inline-json",
          "field": "input_references",
          "item": {
            "type": "image_url",
            "image_url": {
              "url": {
                "from_input": "/url"
              }
            }
          },
          "docs": "https://openrouter.ai/blog/tutorials/image-generation/"
        }
      }
    }
  },
  "endpoint_rules": [
    {
      "when": {
        "type": "object",
        "required": [
          "scheme",
          "host",
          "path",
          "port",
          "has_credentials",
          "has_query",
          "has_fragment"
        ],
        "properties": {
          "scheme": {
            "const": "https"
          },
          "host": {
            "const": "openrouter.ai"
          },
          "path": {
            "enum": [
              "/api/v1",
              "/api/v1/"
            ]
          },
          "port": {
            "type": "null"
          },
          "has_credentials": {
            "const": false
          },
          "has_query": {
            "const": false
          },
          "has_fragment": {
            "const": false
          }
        }
      },
      "endpoints": {
        "images": {
          "address": "https://openrouter.ai/api/v1",
          "interface": "openrouter-images",
          "credential_role": "model"
        }
      }
    }
  ],
  "x_docs": "https://openrouter.ai/docs/guides/overview/multimodal/image-generation"
}
