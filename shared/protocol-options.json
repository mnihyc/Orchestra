                        }
                      }
                    },
                    "then": {
                      "type": "object",
                      "required": [
                        "id",
                        "result"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "result": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              }
            },
            "collections": [
              {
                "pointer": "/output/*",
