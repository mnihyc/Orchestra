{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/app.tsx",
    "src/**/*.d.ts",
    "vite.config.ts",
    "build/**/*.ts",
    "eslint.config.ts",
    "playwright.config.ts",
    "playwright.native.config.ts",
    "playwright.paste.config.ts",
    "e2e",
    "tests/doubles",
    "tests/e2e",
    "tests/accessibility",
    "tests/performance"
  ]
}
