                "properties": {
                  "status": {
                    "const": "completed"
                  },
                  "output": {
                    "type": "array"
                  }
                }
              },
              "items": {
                "pointer": "/output",
                "only_when": {
                  "required": [
                    "type",
                    "status"
                  ],
                  "properties": {
                    "type": {
                      "const": "image_generation_call"
                    },
                    "status": {
                      "const": "completed"
                    }
                  }
                },
                "base64": "/result"
              }
            }
          },
          "x_stream": {
            "partial": {
              "type": "response.image_generation_call.partial_image",
              "bytes": "/partial_image_b64",
              "index": "/partial_image_index",
              "completed": false
            },
            "completed": {
              "type": "response.completed",
              "response": "/response",
              "completed": true
            }
          },
          "x_docs": "https://developers.openai.com/api/docs/guides/tools-image-generation",
          "auxiliary": {
            "prompt": {
              "from_input": "/prompt"
            },
            "options": {},
            "body": {
              "tools": [
                {
                  "from_input": "/native_tool"
                }
              ],
              "tool_choice": {
                "type": "image_generation"
              }
            }
          }
        }
