          "result": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "output"
              ],
              "properties": {
                "status": {
                  "const": "completed"
                },
                "error": {
                  "type": "null"
                },
                "output": {
                  "type": "array",
                  "items": {
                    "if": {
                      "type": "object",
                      "required": [
                        "type",
                        "status"
                      ],
                      "properties": {
