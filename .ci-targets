# Central runs on diag-26 = batch-26-pre 7c746fde2 + every lane head at 15:25Z (pre-split). Leading NAME=value words are settings.
# ladder-ext: the whole imports program with its fix 0a5360b0e (two threads, to keep contention out of the result)
test -p orch-api-core --test imports -- --test-threads=2
# scope-map-a: provider copy after 8aa280f6a
test ORCH_TEST_PROVIDER_COPY_ERRORS=1 ORCH_TEST_NATIVE_OPERATIONS=1 -p orch-api-core --test provider_duplicates -- --nocapture --test-threads=1
# scope-map-b: the fork groups and the duplicate chain after 2303614 and 11860f36f
test ORCH_TEST_NATIVE_OPERATIONS=1 -p orch-api-core --test forks -- batch_cancel_scopes:: side_native_scopes:: preflight_native_scopes:: file_native_scopes:: immediate_native_scopes:: recovery_lifecycle:: confirmation_scopes:: moving_routes:: batch_native_scopes:: --nocapture --test-threads=1
test ORCH_TEST_NATIVE_OPERATIONS=1 -p orch-api-core --test chat_duplicates --test copy_out_ask -- --nocapture --test-threads=1
